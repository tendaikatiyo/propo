# Copy to .env for local runs.
# For GitHub Actions: add the same names as Environment secrets under
# Settings → Environments → production (workflows use environment: production).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Optional — Telegram alerts when a workflow fails
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
